<!-- 
必要なこと
 DONE ーグラウンドプレーンの指定
 ー物理環境の調整（timestepsとか。必要？）
 ーロボットの読み込み、ジョイント、アクチュエータ(torque<=0.021Nm)、センサの指定
 ー慣性モーメントの計算

 ジョイント：タイヤの軸とボディ、前タイヤの軸
 アクチュエータ：前後のタイヤ回転
 センサ：回転角速度センサ、位置センサ、加速度センサ、ボディのIMUセンサ
 -->
<mujoco model="really_simple_arm">
    <compiler angle="degree"/>
    <option integrator="RK4" timestep="0.01" gravity="0 0 -9.81"/>
    <option cone="elliptic"/>
    <option solver="PGS"/>    <!-- 脚系のロボットより bike はPGSの方が安定 -->
    <option iterations="50"/>
    <default>
        <!-- Fusion 360 の座標系を MuJoCo に変換します -->
        <default class="stl">
            <geom type="mesh" xyaxes="1 0 0 0 0 1"/>
        </default>
        <default class="stl_tire">
            <geom type="mesh" xyaxes="1 0 0 0 1 0"/>
        </default>

    </default>
    <asset>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
          markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
        <!-- Fusionはデフォルトでmm単位のメッシュを出力しますが、MuJoCoではmに変換する必要があります。そのため、スケーリングが必要です -->
        <!-- <mesh name="bike" file="models/HBP_ver1_0.stl" scale="0.001 0.001 0.001"/> -->
        <mesh name="body" file="models/body.stl" scale="0.001 0.001 0.001"/>
        <mesh name="F_wheel" file="models/F_wheel.stl" scale="0.001 0.001 0.001"/>
        <mesh name="R_wheel" file="models/R_wheel.stl" scale="0.001 0.001 0.001"/>
        <mesh name="fork" file="models/fork.stl" scale="0.001 0.001 0.001"/>
    </asset>
    <worldbody>
        <light pos="0 0 10.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

        <body name="body" pos="0 0 0.03">
            <geom mesh="body" class="stl"/>
            <joint type="free" name="body_free_joint"/>
            <site name="imu_site" pos="0 0 0.2" size="0.01"/>
            <body name="fork" pos="-0.105 -0.02 0.042">
                <joint name="joint_fork" type="hinge" axis="0 0 1" range="-90 90"/>
                <geom mesh="fork" class="stl"/>
                <body name="F_wheel" pos="0 -0.005 -0.040">
                    <joint name="joint_F_wheel" type="hinge" axis="0 1 0"/>
                    <geom mesh="F_wheel" class="stl_tire" friction="1.0 0.005 0.0001"/>
                </body>
            </body>
            <body name="R_wheel" pos="0 -0.027 0">
                <joint name="joint_R_wheel" type="hinge" axis="0 1 0"/>
                <geom mesh="R_wheel" class="stl_tire" friction="1.0 0.005 0.0001"/>
            </body>
        </body>              
    </worldbody>
    <actuator>
        <motor name="fork" joint="joint_fork"/>
        <motor joint="joint_R_wheel" ctrlrange="-0.021 0.021"/>
    </actuator>
    <sensor>
        <!-- <jointpos name="F_wheel_pos" joint="F_wheel_joint"/> -->
        <jointpos name="F_wheel_pos" joint="joint_F_wheel"/>
        <jointvel name="F_wheel_vel" joint="joint_F_wheel"/>
        <jointpos name="R_wheel_pos" joint="joint_R_wheel"/>
        <jointvel name="R_wheel_vel" joint="joint_R_wheel"/>
        <accelerometer name="imu" site="imu_site"/>
        <gyro name="imu_gyro" site="imu_site"/>
    </sensor>
</mujoco>